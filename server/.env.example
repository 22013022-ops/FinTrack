# Copy these names to server/.env and provide your own secure values. Never commit server/.env.
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/FinanceTracker
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
